{
  "functions": {
    "api/amc/external-snapshot.ts": {
      "maxDuration": 60
    },
    "api/amc/external-intelligence-v2.ts": {
      "maxDuration": 300
    },
    "api/amc/jev-scenario.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/amc-web-mvp", "destination": "/amc-interactive-v2", "permanent": false },
    { "source": "/intake", "destination": "/amc-interactive-v2", "permanent": false },
    { "source": "/format-handoff", "destination": "/amc-interactive-v2", "permanent": false },
    { "source": "/payment-handoff", "destination": "/amc-interactive-v2", "permanent": false },
    { "source": "/payment-success", "destination": "/amc-interactive-v2", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
